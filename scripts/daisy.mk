# Build Tools for Daisy Seed
CC := arm-none-eabi-gcc -fdiagnostics-color -fmax-errors=5
CPP := arm-none-eabi-g++ -fdiagnostics-color -fmax-errors=5
OBJCOPY := arm-none-eabi-objcopy
OBJDUMP := arm-none-eabi-objdump
ADDR2LINE := arm-none-eabi-addr2line
LD := arm-none-eabi-gcc -fdiagnostics-color
AR := arm-none-eabi-gcc-ar
SIZE := arm-none-eabi-size
STRIP := arm-none-eabi-strip
READELF := arm-none-eabi-readelf
NM := arm-none-eabi-nm
SWIG := swig
PYTHON := python3
ZIP := zip
